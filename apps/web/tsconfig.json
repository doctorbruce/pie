{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"customConditions": ["source"],
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],

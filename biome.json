{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"formatter": {
		"enabled": true,
		"indentWidth": 3,
		"lineWidth": 120,
		"indentStyle": "tab"
	},
	"linter": {
		"rules": {
			"suspicious": {
				"noControlCharactersInRegex": "off",
				"noExplicitAny": "off",
				"noEmptyInterface": "off"
			},
			"recommended": true,
			"style": {
				"useNodejsImportProtocol": "off",
				"useConst": "error",
				"noNonNullAssertion": "off"
			}
		},
		"enabled": true
	},
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.ts",
			"examples/**/*.ts",
			"apps/**/*.ts",
			"apps/**/*.tsx",
			"apps/**/*.json",
			"apps/**/*.css",
			"*.json",
			"packages/*/package.json",
			"!package-lock.json",
			"!**/models.generated.ts",
			"!**/*.models.ts",
			"!!**/node_modules"
		]
	}
}

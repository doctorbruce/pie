{
	"name": "pie",
	"version": "0.0.3",
	"private": true,
	"type": "module",
	"license": "MIT",
	"exports": {
		".": "./packages/agent/src/index.ts",
		"./runtime": "./packages/runtime/src/index.ts"
	},
	"workspaces": [
		"packages/mcp",
		"packages/agent",
		"packages/ai",
		"packages/telemetry",
		"packages/runtime",
		"packages/local",
		"packages/server"
	],
	"scripts": {
		"serve": "node --conditions=source --env-file-if-exists=.env packages/server/src/cli.ts",
		"build:sidecar": "node packages/server/scripts/build-sidecar.mjs",
		"build:sidecar:bun": "node packages/server/scripts/build-sidecar-bun.mjs",
		"prompts": "node apps/prompt-viewer/server.mjs",
		"check": "biome check --error-on-warnings . && tsc --noEmit && npm run check:model-data",
		"check:fix": "biome check --write --error-on-warnings .",
		"test:core": "npm exec --workspace=@earendil-works/pi-agent-core -- vitest run test/agent.test.ts test/agent-loop.test.ts test/message-replacement.test.ts test/streamed-tool-execution.test.ts test/cancellation.test.ts",
		"test:mcp": "npm exec --workspace=@earendil-works/pi-mcp -- vitest run",
		"test:runtime": "node scripts/run-node-tests.mjs packages/runtime/test",
		"test:server": "node --expose-gc scripts/run-node-tests.mjs packages/runtime/test packages/server/test apps/prompt-viewer/test",
		"example": "node --conditions=source examples/basic.ts",
		"hydrate:model-data": "npm run hydrate-model-data --workspace=@earendil-works/pi-ai",
		"check:model-data": "npm run check:model-data --workspace=@earendil-works/pi-ai",
		"build": "npm run build --workspace=@earendil-works/pi-telemetry && npm run build:offline --workspace=@earendil-works/pi-ai && npm run build --workspace=@earendil-works/pi-agent-core"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"esbuild": "0.28.1",
		"postject": "1.0.0-alpha.6",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
